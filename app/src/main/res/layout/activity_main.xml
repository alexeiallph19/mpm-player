<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout" android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Classic file browser -->
    <LinearLayout android:id="@+id/welcomeScreen" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:background="#202020">
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
            android:background="#303030">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_mpm_logo" android:contentDescription="MPM" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingStart="9dp" android:text="MPM Player" android:textColor="#F2F2F2"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            <Button android:id="@+id/btnLibraryRefresh" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="38dp" android:minWidth="0dp"
                android:text="⟳" android:textColor="#E5E5E5" android:textSize="20sp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Actualizar biblioteca" />
            <Button android:id="@+id/btnLibrarySettings" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="40dp" android:layout_height="38dp" android:minWidth="0dp"
                android:text="⚙" android:textColor="#E5E5E5" android:textSize="18sp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Ajustes" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:background="#252525"
            android:paddingStart="7dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Archivo     Ver     Reproducción     Navegar     Ayuda"
                android:textColor="#D8D8D8" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#1B1B1B">
            <TextView android:id="@+id/libraryHeading" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Biblioteca multimedia" android:textColor="#F0F0F0"
                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/librarySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Archivos locales" android:textColor="#AFAFAF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="8dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp"
            android:background="#303030">
            <TextView android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center"
                android:text="⌕" android:textColor="#BBBBBB" android:textSize="21sp" />
            <EditText android:id="@+id/librarySearch" android:layout_width="match_parent"
                android:layout_height="match_parent" android:background="@android:color/transparent"
                android:hint="Buscar archivos" android:singleLine="true" android:textColor="#FFFFFF"
                android:textColorHint="#999999" android:textSize="13sp" android:imeOptions="actionSearch"
                android:inputType="text" android:paddingStart="5dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="42dp"
            android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="7dp">
                <Button android:id="@+id/btnLibraryVideos" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp"
                    android:text="Vídeos" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"
                    android:background="#404040" />
                <Button android:id="@+id/btnLibraryFolders" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp"
                    android:text="Carpetas" android:textAllCaps="false" android:textColor="#D0D0D0" android:textSize="12sp" />
                <Button android:id="@+id/btnLibraryRecent" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp"
                    android:text="Recientes" android:textAllCaps="false" android:textColor="#D0D0D0" android:textSize="12sp" />
                <Button android:id="@+id/btnLibraryFavorites" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp"
                    android:text="Favoritos" android:textAllCaps="false" android:textColor="#D0D0D0" android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#454545" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:id="@+id/libraryItems" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="12dp" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp"
            android:paddingEnd="8dp" android:background="#292929">
            <Button android:id="@+id/btnLibraryOpen" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
                android:minHeight="0dp" android:text="Abrir archivo…" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="13sp" android:background="#444444" />
            <Button android:id="@+id/btnLibraryPlaylist" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="104dp" android:layout_height="38dp" android:layout_marginStart="6dp"
                android:minWidth="0dp" android:minHeight="0dp" android:text="Lista" android:textAllCaps="false"
                android:textColor="#E5E5E5" android:textSize="12sp" android:background="#383838" />
        </LinearLayout>
    </LinearLayout>

    <!-- MPC-QT inspired title bar and classic menu strip -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical" android:background="#303030"
        android:elevation="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="5dp"
            android:paddingEnd="8dp" android:background="#383838">
            <ImageButton android:id="@+id/btnPlayerBack" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="30dp" android:layout_height="30dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/mpm_ic_previous"
                android:tint="#EEEEEE" android:scaleType="center" android:contentDescription="Volver a la biblioteca" />
            <TextView android:id="@+id/txtStatus" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1"
                android:ellipsize="middle" android:text="MPM Player" android:textColor="#F0F0F0"
                android:textSize="12sp" android:fontFamily="sans-serif" android:paddingStart="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MPM" android:textColor="#BDBDBD" android:textSize="10sp" android:paddingEnd="4dp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="36dp"
            android:fillViewport="false" android:scrollbars="none" android:background="#292929">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="2dp">
                <Button android:id="@+id/btnMenuArchivo" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Archivo" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
                <Button android:id="@+id/btnMenuVer" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Ver" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
                <Button android:id="@+id/btnMenuReproducir" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Reproducir" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
                <Button android:id="@+id/btnMenuNavegar" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Navegar" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
                <Button android:id="@+id/btnMenuFavoritos" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Favoritos" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
                <Button android:id="@+id/btnMenuAyuda" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:includeFontPadding="false" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:background="@android:color/transparent" android:text="Ayuda" android:textAllCaps="false" android:textSize="12sp" android:textColor="#EAEAEA" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/centerControls" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:orientation="horizontal" android:visibility="gone">
        <ImageButton android:id="@+id/btnCenterPlay" style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/mpm_ic_play"
            android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Reproducir" />
    </LinearLayout>
    <TextView android:id="@+id/txtOsd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="74dp"
        android:background="@drawable/vlc_osd_background" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="#FFFFFF" android:textSize="12sp"
        android:visibility="gone" />

    <!-- Flat transport panel: seek information, timeline, transport and status -->
    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:background="#292929"
        android:elevation="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="23dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="9dp" android:paddingEnd="9dp" android:background="#303030">
            <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00:00" android:textColor="#F0F0F0" android:textSize="11sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/txtRemaining" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:text="-00:00:00"
                android:textColor="#C4C4C4" android:textSize="11sp" android:fontFamily="monospace" />
        </LinearLayout>
        <com.mpcmovil.VlcAccessibleSeekBar android:id="@+id/seekBar"
            android:layout_width="match_parent" android:layout_height="20dp" android:max="1000"
            android:minHeight="4dp" android:maxHeight="4dp" android:paddingStart="7dp" android:paddingEnd="7dp"
            android:progressDrawable="@drawable/mpm_seekbar_track" android:thumb="@drawable/mpm_seekbar_thumb"
            android:thumbOffset="9dp" android:splitTrack="false" android:contentDescription="Barra de progreso del video" />
        <LinearLayout android:id="@+id/playerControlsRow" android:layout_width="match_parent"
            android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="5dp" android:paddingEnd="5dp" android:background="#292929">
            <LinearLayout android:id="@+id/playerControlsLeft" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start"
                android:orientation="horizontal">
                <ImageButton android:id="@+id/btnAudioTrack" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="30dp" android:layout_height="34dp" android:background="@drawable/mpm_classic_controls"
                    android:src="@drawable/vlc_ic_audiotrack" android:scaleType="fitCenter" android:padding="8dp"
                    android:contentDescription="Pistas de audio" android:backgroundTint="@null" android:stateListAnimator="@null" />
                <ImageButton android:id="@+id/btnSubtitleTrack" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="32dp" android:layout_height="34dp" android:layout_marginStart="2dp"
                    android:background="@drawable/mpm_classic_controls" android:src="@drawable/vlc_ic_subtitle"
                    android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Subtítulos"
                    android:backgroundTint="@null" android:stateListAnimator="@null" />
            </LinearLayout>
            <LinearLayout android:id="@+id/playerControlsCenter" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="34dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:src="@drawable/mpm_ic_previous" android:scaleType="fitCenter" android:padding="8dp"
                    android:background="@drawable/mpm_classic_controls" android:contentDescription="Retroceder"
                    android:backgroundTint="@null" android:stateListAnimator="@null" />
                <ImageButton android:id="@+id/btnPlay" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="40dp" android:layout_height="36dp" android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/mpm_classic_controls" android:src="@drawable/mpm_ic_pause"
                    android:scaleType="fitCenter" android:padding="9dp" android:contentDescription="Pausar"
                    android:backgroundTint="@null" android:stateListAnimator="@null" />
                <ImageButton android:id="@+id/btnForward" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="34dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:src="@drawable/mpm_ic_next" android:scaleType="fitCenter" android:padding="8dp"
                    android:background="@drawable/mpm_classic_controls" android:contentDescription="Avanzar"
                    android:backgroundTint="@null" android:stateListAnimator="@null" />
            </LinearLayout>
            <LinearLayout android:id="@+id/playerControlsRight" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <ImageButton android:id="@+id/btnRotateBottom" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="28dp" android:layout_height="34dp" android:background="@drawable/mpm_classic_controls"
                    android:src="@drawable/vlc_ic_rotate" android:scaleType="fitCenter" android:padding="8dp"
                    android:contentDescription="Rotación" android:backgroundTint="@null" android:stateListAnimator="@null" />
                <ImageButton android:id="@+id/btnCastBottom" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="32dp" android:layout_height="34dp" android:layout_marginStart="2dp"
                    android:background="@drawable/mpm_classic_controls" android:src="@drawable/vlc_ic_cast"
                    android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Emitir"
                    android:backgroundTint="@null" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnSpeed" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="34dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/mpm_classic_controls" android:text="1.0x" android:textAllCaps="false"
                    android:textColor="#F2F2F2" android:textSize="10sp" android:backgroundTint="@null" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnMainMenu" style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="30dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/mpm_classic_controls" android:text="☰" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:contentDescription="Más opciones" android:backgroundTint="@null" android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="19dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp"
            android:paddingEnd="8dp" android:background="#222222">
            <TextView android:id="@+id/txtDecoderInfo" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="start|center_vertical" android:text="[HW]"
                android:textColor="#BDBDBD" android:textSize="10sp" android:fontFamily="monospace" />
            <Button android:id="@+id/btnHwSw" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp"
                android:minHeight="0dp" android:text="HW" />
            <Button android:id="@+id/btnPause" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp" android:minHeight="0dp" />
            <Button android:id="@+id/btnStop" style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:minWidth="0dp" android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/btnScreenshotFloat" style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp" android:backgroundTint="#CC202020" android:visibility="gone"
        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="▣"
        android:textColor="#FFFFFF" android:textSize="19sp" />
</FrameLayout>